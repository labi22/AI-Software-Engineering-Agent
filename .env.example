# =============================================================================
#  AI Software Engineering Agent — Environment Configuration Reference
#  Copy this file to .env and fill in real values.
#  Never commit .env to version control.
# =============================================================================


# ---------------------------------------------------------------------------
# LLM Provider
# ---------------------------------------------------------------------------
# Supported: openai | groq | ollama | fake
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1

# OpenAI-compatible base URL (leave empty for official OpenAI endpoint)
# Example for Groq: https://api.groq.com/openai/v1
LLM_BASE_URL=

OPENAI_API_KEY=sk-...
GROQ_API_KEY=gs_...

# Request timeout in seconds for a single LLM call
LLM_REQUEST_TIMEOUT_SECONDS=30


# ---------------------------------------------------------------------------
# LLM Admission Control & Retry Policy  (Phase 5D)
# ---------------------------------------------------------------------------
# Hard cap on requests per minute sent to the upstream LLM provider
LLM_RPM_LIMIT=30

# Number of retry attempts on transient provider errors before giving up
LLM_MAX_RETRIES=3

# Exponential back-off base and ceiling (seconds)
LLM_RETRY_BASE_DELAY=1.0
LLM_RETRY_MAX_DELAY=10.0


# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------
# Supported: openai | huggingface | fake
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# HuggingFace / local model example:
# EMBEDDING_PROVIDER=huggingface
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DIMENSION=384


# ---------------------------------------------------------------------------
# Vector Store
# ---------------------------------------------------------------------------
# Supported: memory | pgvector
# Defaults to pgvector when DATABASE_URL is set, otherwise memory
VECTOR_STORE_TYPE=pgvector


# ---------------------------------------------------------------------------
# PostgreSQL  (required for pgvector, auth, durable jobs, checkpoints)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://agent:secret@localhost:5432/agent_db


# ---------------------------------------------------------------------------
# Redis  (Phase 5C — rate limits, idempotency, caching, job coordination)
# ---------------------------------------------------------------------------
# Leave empty to fall back to in-process in-memory coordination (dev only)
REDIS_URL=redis://localhost:6379/0


# ---------------------------------------------------------------------------
# Rate Limiting  (per-tenant, per-minute sliding window)
# ---------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60

# Maximum concurrent LangGraph agent runs per tenant
TENANT_MAX_CONCURRENT_RUNS=2

# Idempotency key TTL — how long duplicate-request records are retained (seconds)
IDEMPOTENCY_TTL_SECONDS=86400


# ---------------------------------------------------------------------------
# Repository Ingestion
# ---------------------------------------------------------------------------
# Comma-separated list of local directory roots the agent is allowed to scan
# Example: ALLOWED_REPOSITORY_ROOTS=/repos/project-a,/repos/project-b
ALLOWED_REPOSITORY_ROOTS=C:\\Users\\saksh\\Yield Curve Construction and Bond Valuation & Risk Lab

# Chunking settings
CHUNK_SIZE_LINES=60
CHUNK_OVERLAP_LINES=15

# GitHub clone limits
GITHUB_CLONE_TIMEOUT_SECONDS=60
GITHUB_MAX_REPOSITORY_BYTES=104857600
GITHUB_MAX_FILES=10000


# ---------------------------------------------------------------------------
# Agent Loop
# ---------------------------------------------------------------------------
AGENT_MAX_STEPS=10
AGENT_STEP_TIMEOUT_SECONDS=30.0
TOOL_TIMEOUT_SECONDS=30.0
TOOL_MAX_OUTPUT_CHARS=8000


# ---------------------------------------------------------------------------
# Authentication & Multi-Tenancy  (Phase 4)
# ---------------------------------------------------------------------------
# Set to true to enforce API-key authentication on all protected endpoints
AUTH_ENABLED=false

# Comma-separated list of key entries: <key_id>:<sha256_hex>:<organization_id>
# Generate hash: python -c "import hashlib; print(hashlib.sha256(b'<raw_key>').hexdigest())"
# Example: key-1:e3b0c44298fc1c149afb...:org-abc,key-2:...
AUTH_API_KEY_HASHES=
